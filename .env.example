# Copy to .env and change every value marked CHANGE-ME. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://inv:inv@localhost:5432/inventory
# 32+ random chars, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=CHANGE-ME-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT_MAX=10
# Used only by `npm run db:seed` to create the first ADMIN
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE-ME-strong-password
COMPANY_NAME=Your Company
COMPANY_TIMEZONE=Asia/Kolkata
