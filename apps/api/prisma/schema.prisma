generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STORE
  VIEWER
}

enum TrackingType {
  NONE
  BATCH
  SERIAL
}

enum ProductType {
  FINISHED_GOOD
  SEMI_FINISHED
  RAW_MATERIAL
  COMPONENT
  CONSUMABLE
  OTHER
}

enum TxnType {
  OPENING_STOCK
  PROCUREMENT
  DISPATCH
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  CONVERSION_IN
  CONVERSION_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  SCRAP
  TRANSFER_IN
  TRANSFER_OUT
  REVERSAL
}

enum StockStatus {
  USABLE
  DAMAGED
  INSPECTION
}

enum DocStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
  NEEDS_INSPECTION
}

enum StockActionType {
  DAMAGE
  SCRAP
  REPAIR
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  name                  String
  passwordHash          String                 @map("password_hash")
  role                  Role
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]

  procurementsCreated Procurement[] @relation("ProcCreatedBy")
  dispatchesCreated   Dispatch[]    @relation("DispCreatedBy")

  conversionsCreated Conversion[]         @relation("ConvCreatedBy")
  templatesCreated   ConversionTemplate[]

  customerReturnsCreated CustomerReturn[]  @relation("CustRetCreatedBy")
  supplierReturnsCreated SupplierReturn[]  @relation("SuppRetCreatedBy")
  stockActionsCreated    StockActionDoc[]  @relation("StockActCreatedBy")
  adjustmentsCreated     StockAdjustment[] @relation("AdjCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  items       Item[]

  @@map("categories")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items     Item[]

  procurementLines ProcurementItem[]
  dispatchLines    DispatchItem[]

  conversionInputs  ConversionInput[]
  conversionOutputs ConversionOutput[]

  customerReturnLines CustomerReturnItem[]
  supplierReturnLines SupplierReturnItem[]

  @@map("units")
}

model Item {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  categoryId    String       @map("category_id") @db.Uuid
  subcategory   String?
  description   String?
  unitId        String       @map("unit_id") @db.Uuid
  productType   ProductType  @map("product_type")
  trackingType  TrackingType @default(NONE) @map("tracking_type")
  minLevel      Decimal      @default(0) @map("min_level") @db.Decimal(18, 3)
  reorderLevel  Decimal      @default(0) @map("reorder_level") @db.Decimal(18, 3)
  maxLevel      Decimal      @default(0) @map("max_level") @db.Decimal(18, 3)
  hsnSac        String?      @map("hsn_sac")
  gstRate       Decimal      @default(0) @map("gst_rate") @db.Decimal(5, 2)
  purchasePrice Decimal      @default(0) @map("purchase_price") @db.Decimal(18, 2)
  sellingPrice  Decimal      @default(0) @map("selling_price") @db.Decimal(18, 2)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  category      Category     @relation(fields: [categoryId], references: [id])
  unit          Unit         @relation(fields: [unitId], references: [id])

  txnLines InventoryTransactionItem[]
  balances StockBalance[]

  procurementLines ProcurementItem[]
  dispatchLines    DispatchItem[]

  conversionInputs  ConversionInput[]
  conversionOutputs ConversionOutput[]
  templateInputs    ConversionTemplateInput[]
  templateOutputs   ConversionTemplateOutput[]

  customerReturnLines CustomerReturnItem[]
  supplierReturnLines SupplierReturnItem[]
  stockActions        StockActionDoc[]
  adjustments         StockAdjustment[]

  @@index([categoryId])
  @@index([unitId])
  @@index([name])
  @@map("items")
}

model Client {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @map("company_name")
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  gstin         String?
  remarks       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  dispatches Dispatch[]

  customerReturns CustomerReturn[]

  @@index([companyName])
  @@map("clients")
}

model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @map("company_name")
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  gstin         String?
  remarks       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  transactions InventoryTransaction[]

  procurements Procurement[]

  supplierReturns SupplierReturn[]

  @@index([companyName])
  @@map("suppliers")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  txnLines InventoryTransactionItem[]
  balances StockBalance[]

  procurements Procurement[]
  dispatches   Dispatch[]

  conversions Conversion[]

  customerReturns CustomerReturn[]
  supplierReturns SupplierReturn[]
  stockActions    StockActionDoc[]
  adjustments     StockAdjustment[]

  @@map("warehouses")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Append-only header of one stock movement. Enforced by DB trigger; corrections are REVERSAL rows.
model InventoryTransaction {
  id             String                     @id @default(uuid()) @db.Uuid
  txnNo          String                     @unique @default(dbgenerated("('TXN-' || lpad(nextval('inventory_txn_seq')::text, 8, '0'))")) @map("txn_no")
  type           TxnType
  /// Business date (not the created timestamp).
  txnDate        DateTime                   @map("txn_date") @db.Date
  referenceType  String?                    @map("reference_type")
  referenceId    String?                    @map("reference_id")
  referenceNo    String?                    @map("reference_no")
  clientId       String?                    @map("client_id") @db.Uuid
  supplierId     String?                    @map("supplier_id") @db.Uuid
  /// Links the legs of a transfer / conversion.
  groupId        String?                    @map("group_id")
  reversesTxnId  String?                    @unique @map("reverses_txn_id") @db.Uuid
  idempotencyKey String?                    @unique @map("idempotency_key")
  remarks        String?
  createdById    String                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                   @default(now()) @map("created_at")
  createdBy      User                       @relation(fields: [createdById], references: [id])
  client         Client?                    @relation(fields: [clientId], references: [id])
  supplier       Supplier?                  @relation(fields: [supplierId], references: [id])
  reversesTxn    InventoryTransaction?      @relation("Reversal", fields: [reversesTxnId], references: [id])
  reversedBy     InventoryTransaction?      @relation("Reversal")
  lines          InventoryTransactionItem[]

  procurement Procurement?
  dispatch    Dispatch?

  conversionOut Conversion? @relation("ConvOut")
  conversionIn  Conversion? @relation("ConvIn")

  customerReturn  CustomerReturn?
  supplierReturn  SupplierReturn?
  stockAction     StockActionDoc?  @relation("StockActTxn")
  stockActionPair StockActionDoc?  @relation("StockActPairTxn")
  adjustment      StockAdjustment?

  @@index([txnDate])
  @@index([type, txnDate])
  @@index([referenceNo])
  @@index([groupId])
  @@index([clientId])
  @@index([supplierId])
  @@map("inventory_transactions")
}

model InventoryTransactionItem {
  id          String               @id @default(uuid()) @db.Uuid
  txnId       String               @map("txn_id") @db.Uuid
  lineNo      Int                  @map("line_no")
  itemId      String               @map("item_id") @db.Uuid
  warehouseId String               @map("warehouse_id") @db.Uuid
  stockStatus StockStatus          @default(USABLE) @map("stock_status")
  qtyIn       Decimal              @default(0) @map("qty_in") @db.Decimal(18, 3)
  qtyOut      Decimal              @default(0) @map("qty_out") @db.Decimal(18, 3)
  /// Kept per line so FIFO / weighted-average valuation can be added later.
  unitCost    Decimal?             @map("unit_cost") @db.Decimal(18, 2)
  batchNo     String?              @map("batch_no")
  serialNo    String?              @map("serial_no")
  mfgDate     DateTime?            @map("mfg_date") @db.Date
  expiryDate  DateTime?            @map("expiry_date") @db.Date
  txn         InventoryTransaction @relation(fields: [txnId], references: [id])
  item        Item                 @relation(fields: [itemId], references: [id])
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id])

  @@unique([txnId, lineNo])
  @@index([itemId, warehouseId, stockStatus])
  @@index([batchNo])
  @@map("inventory_transaction_items")
}

/// Cache of the ledger. Only InventoryService writes here, inside the posting transaction.
model StockBalance {
  itemId      String      @map("item_id") @db.Uuid
  warehouseId String      @map("warehouse_id") @db.Uuid
  stockStatus StockStatus @map("stock_status")
  qty         Decimal     @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime    @updatedAt @map("updated_at")
  item        Item        @relation(fields: [itemId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])

  @@id([itemId, warehouseId, stockStatus])
  @@map("stock_balances")
}

model Procurement {
  id             String                @id @default(uuid()) @db.Uuid
  grnNo          String                @unique @map("grn_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  supplierId     String                @map("supplier_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  /// Ledger transaction created on confirm.
  txnId          String?               @unique @map("txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  txn            InventoryTransaction? @relation(fields: [txnId], references: [id])
  createdBy      User                  @relation("ProcCreatedBy", fields: [createdById], references: [id])
  lines          ProcurementItem[]

  supplierReturns SupplierReturn[]

  @@index([txnDate])
  @@index([supplierId])
  @@index([status])
  @@map("procurements")
}

model ProcurementItem {
  id            String      @id @default(uuid()) @db.Uuid
  procurementId String      @map("procurement_id") @db.Uuid
  lineNo        Int         @map("line_no")
  itemId        String      @map("item_id") @db.Uuid
  unitId        String      @map("unit_id") @db.Uuid
  qty           Decimal     @db.Decimal(18, 3)
  rate          Decimal     @db.Decimal(18, 2)
  gstRate       Decimal     @default(0) @map("gst_rate") @db.Decimal(5, 2)
  /// qty * rate * (1 + gst/100), computed server-side.
  amount        Decimal     @db.Decimal(18, 2)
  batchNo       String?     @map("batch_no")
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  item          Item        @relation(fields: [itemId], references: [id])
  unit          Unit        @relation(fields: [unitId], references: [id])

  @@unique([procurementId, lineNo])
  @@index([itemId])
  @@map("procurement_items")
}

model Dispatch {
  id             String                @id @default(uuid()) @db.Uuid
  challanNo      String                @unique @map("challan_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  clientId       String                @map("client_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  address        String?
  vehicleNo      String?               @map("vehicle_no")
  driverName     String?               @map("driver_name")
  salesOrderNo   String?               @map("sales_order_no")
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  txnId          String?               @unique @map("txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  client         Client                @relation(fields: [clientId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  txn            InventoryTransaction? @relation(fields: [txnId], references: [id])
  createdBy      User                  @relation("DispCreatedBy", fields: [createdById], references: [id])
  lines          DispatchItem[]

  customerReturns CustomerReturn[]

  @@index([txnDate])
  @@index([clientId])
  @@index([status])
  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid()) @db.Uuid
  dispatchId String   @map("dispatch_id") @db.Uuid
  lineNo     Int      @map("line_no")
  itemId     String   @map("item_id") @db.Uuid
  unitId     String   @map("unit_id") @db.Uuid
  qty        Decimal  @db.Decimal(18, 3)
  rate       Decimal? @db.Decimal(18, 2)
  amount     Decimal? @db.Decimal(18, 2)
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id])
  unit       Unit     @relation(fields: [unitId], references: [id])

  @@unique([dispatchId, lineNo])
  @@index([itemId])
  @@map("dispatch_items")
}

/// Key/value application settings (e.g. approval thresholds). Changes are audited.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ConversionTemplate {
  id          String                     @id @default(uuid()) @db.Uuid
  name        String
  description String?
  active      Boolean                    @default(true)
  createdById String                     @map("created_by_id") @db.Uuid
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  createdBy   User                       @relation(fields: [createdById], references: [id])
  inputs      ConversionTemplateInput[]
  outputs     ConversionTemplateOutput[]
  conversions Conversion[]

  @@map("conversion_templates")
}

/// Quantities are per ONE unit of the template multiplier.
model ConversionTemplateInput {
  id         String             @id @default(uuid()) @db.Uuid
  templateId String             @map("template_id") @db.Uuid
  lineNo     Int                @map("line_no")
  itemId     String             @map("item_id") @db.Uuid
  qty        Decimal            @db.Decimal(18, 3)
  template   ConversionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       Item               @relation(fields: [itemId], references: [id])

  @@unique([templateId, lineNo])
  @@map("conversion_template_inputs")
}

model ConversionTemplateOutput {
  id         String             @id @default(uuid()) @db.Uuid
  templateId String             @map("template_id") @db.Uuid
  lineNo     Int                @map("line_no")
  itemId     String             @map("item_id") @db.Uuid
  qty        Decimal            @db.Decimal(18, 3)
  template   ConversionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       Item               @relation(fields: [itemId], references: [id])

  @@unique([templateId, lineNo])
  @@map("conversion_template_outputs")
}

model Conversion {
  id             String                @id @default(uuid()) @db.Uuid
  conversionNo   String                @unique @default(dbgenerated("('CONV-' || lpad(nextval('conversion_no_seq')::text, 6, '0'))")) @map("conversion_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  warehouseId    String                @map("warehouse_id") @db.Uuid
  templateId     String?               @map("template_id") @db.Uuid
  multiplier     Decimal               @default(1) @db.Decimal(18, 3)
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  /// Ledger transactions created on confirm (inputs out, outputs in), linked by group_id = conversion_no.
  outTxnId       String?               @unique @map("out_txn_id") @db.Uuid
  inTxnId        String?               @unique @map("in_txn_id") @db.Uuid
  approvalStatus ApprovalStatus        @default(NONE) @map("approval_status")
  approvedById   String?               @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  template       ConversionTemplate?   @relation(fields: [templateId], references: [id])
  createdBy      User                  @relation("ConvCreatedBy", fields: [createdById], references: [id])
  outTxn         InventoryTransaction? @relation("ConvOut", fields: [outTxnId], references: [id])
  inTxn          InventoryTransaction? @relation("ConvIn", fields: [inTxnId], references: [id])
  inputs         ConversionInput[]
  outputs        ConversionOutput[]

  @@index([txnDate])
  @@index([status])
  @@map("conversions")
}

model ConversionInput {
  id           String     @id @default(uuid()) @db.Uuid
  conversionId String     @map("conversion_id") @db.Uuid
  lineNo       Int        @map("line_no")
  itemId       String     @map("item_id") @db.Uuid
  unitId       String     @map("unit_id") @db.Uuid
  qty          Decimal    @db.Decimal(18, 3)
  conversion   Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id])
  unit         Unit       @relation(fields: [unitId], references: [id])

  @@unique([conversionId, lineNo])
  @@index([itemId])
  @@map("conversion_inputs")
}

model ConversionOutput {
  id           String     @id @default(uuid()) @db.Uuid
  conversionId String     @map("conversion_id") @db.Uuid
  lineNo       Int        @map("line_no")
  itemId       String     @map("item_id") @db.Uuid
  unitId       String     @map("unit_id") @db.Uuid
  qty          Decimal    @db.Decimal(18, 3)
  conversion   Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id])
  unit         Unit       @relation(fields: [unitId], references: [id])

  @@unique([conversionId, lineNo])
  @@index([itemId])
  @@map("conversion_outputs")
}

model CustomerReturn {
  id             String                @id @default(uuid()) @db.Uuid
  returnNo       String                @unique @map("return_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  clientId       String                @map("client_id") @db.Uuid
  dispatchId     String                @map("dispatch_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  txnId          String?               @unique @map("txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  client         Client                @relation(fields: [clientId], references: [id])
  dispatch       Dispatch              @relation(fields: [dispatchId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  txn            InventoryTransaction? @relation(fields: [txnId], references: [id])
  createdBy      User                  @relation("CustRetCreatedBy", fields: [createdById], references: [id])
  lines          CustomerReturnItem[]

  @@index([txnDate])
  @@index([dispatchId])
  @@index([status])
  @@map("customer_returns")
}

model CustomerReturnItem {
  id        String          @id @default(uuid()) @db.Uuid
  returnId  String          @map("return_id") @db.Uuid
  lineNo    Int             @map("line_no")
  itemId    String          @map("item_id") @db.Uuid
  unitId    String          @map("unit_id") @db.Uuid
  qty       Decimal         @db.Decimal(18, 3)
  condition ReturnCondition
  reason    String?
  ret       CustomerReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item      Item            @relation(fields: [itemId], references: [id])
  unit      Unit            @relation(fields: [unitId], references: [id])

  @@unique([returnId, lineNo])
  @@index([itemId])
  @@map("customer_return_items")
}

model SupplierReturn {
  id             String                @id @default(uuid()) @db.Uuid
  returnNo       String                @unique @map("return_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  supplierId     String                @map("supplier_id") @db.Uuid
  procurementId  String                @map("procurement_id") @db.Uuid
  warehouseId    String                @map("warehouse_id") @db.Uuid
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  txnId          String?               @unique @map("txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  procurement    Procurement           @relation(fields: [procurementId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  txn            InventoryTransaction? @relation(fields: [txnId], references: [id])
  createdBy      User                  @relation("SuppRetCreatedBy", fields: [createdById], references: [id])
  lines          SupplierReturnItem[]

  @@index([txnDate])
  @@index([procurementId])
  @@index([status])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id          String         @id @default(uuid()) @db.Uuid
  returnId    String         @map("return_id") @db.Uuid
  lineNo      Int            @map("line_no")
  itemId      String         @map("item_id") @db.Uuid
  unitId      String         @map("unit_id") @db.Uuid
  qty         Decimal        @db.Decimal(18, 3)
  /// Bucket the goods leave from (USABLE or DAMAGED).
  stockStatus StockStatus    @default(USABLE) @map("stock_status")
  reason      String?
  ret         SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  item        Item           @relation(fields: [itemId], references: [id])
  unit        Unit           @relation(fields: [unitId], references: [id])

  @@unique([returnId, lineNo])
  @@index([itemId])
  @@map("supplier_return_items")
}

/// DAMAGE (USABLE→DAMAGED), SCRAP (removes DAMAGED), REPAIR (DAMAGED→USABLE). Reason is mandatory.
model StockActionDoc {
  id             String                @id @default(uuid()) @db.Uuid
  actionNo       String                @unique @default(dbgenerated("('DMG-' || lpad(nextval('stock_action_no_seq')::text, 6, '0'))")) @map("action_no")
  action         StockActionType
  txnDate        DateTime              @map("txn_date") @db.Date
  warehouseId    String                @map("warehouse_id") @db.Uuid
  itemId         String                @map("item_id") @db.Uuid
  qty            Decimal               @db.Decimal(18, 3)
  reason         String
  status         DocStatus             @default(DRAFT)
  remarks        String?
  idempotencyKey String?               @unique @map("idempotency_key")
  /// DAMAGE/SCRAP: the single ledger txn. REPAIR: the DAMAGED-out leg (the USABLE-in leg is pairTxnId).
  txnId          String?               @unique @map("txn_id") @db.Uuid
  pairTxnId      String?               @unique @map("pair_txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  item           Item                  @relation(fields: [itemId], references: [id])
  txn            InventoryTransaction? @relation("StockActTxn", fields: [txnId], references: [id])
  pairTxn        InventoryTransaction? @relation("StockActPairTxn", fields: [pairTxnId], references: [id])
  createdBy      User                  @relation("StockActCreatedBy", fields: [createdById], references: [id])

  @@index([txnDate])
  @@index([status])
  @@map("stock_actions")
}

/// Physical-count correction. Always needs manager approval before it touches the ledger.
model StockAdjustment {
  id             String                @id @default(uuid()) @db.Uuid
  adjustmentNo   String                @unique @default(dbgenerated("('ADJ-' || lpad(nextval('stock_adjustment_no_seq')::text, 6, '0'))")) @map("adjustment_no")
  txnDate        DateTime              @map("txn_date") @db.Date
  warehouseId    String                @map("warehouse_id") @db.Uuid
  itemId         String                @map("item_id") @db.Uuid
  stockStatus    StockStatus           @default(USABLE) @map("stock_status")
  /// Balance at the time the draft was saved; confirm is refused if stock moved since.
  systemQty      Decimal               @map("system_qty") @db.Decimal(18, 3)
  physicalQty    Decimal               @map("physical_qty") @db.Decimal(18, 3)
  /// physicalQty - systemQty (never zero).
  difference     Decimal               @db.Decimal(18, 3)
  reason         String
  remarks        String?
  status         DocStatus             @default(DRAFT)
  approvalStatus ApprovalStatus        @default(NONE) @map("approval_status")
  approvedById   String?               @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  idempotencyKey String?               @unique @map("idempotency_key")
  txnId          String?               @unique @map("txn_id") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at")
  cancelledAt    DateTime?             @map("cancelled_at")
  cancelReason   String?               @map("cancel_reason")
  createdById    String                @map("created_by_id") @db.Uuid
  confirmedById  String?               @map("confirmed_by_id") @db.Uuid
  cancelledById  String?               @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  item           Item                  @relation(fields: [itemId], references: [id])
  txn            InventoryTransaction? @relation(fields: [txnId], references: [id])
  createdBy      User                  @relation("AdjCreatedBy", fields: [createdById], references: [id])

  @@index([txnDate])
  @@index([status])
  @@map("stock_adjustments")
}
